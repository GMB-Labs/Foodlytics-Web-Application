{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/|assets/|images/|favicon.ico|robots.txt).*)", "destination": "/api/ssr" }
  ],
  "functions": {
    "api/ssr.js": {
      "maxDuration": 60,
      "includeFiles": "dist/foodlytics/server/**"
    }
  }
}