{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/api/ssr"
    }
  ],
  "functions": {
    "api/ssr.js": {
      "maxDuration": 60,
      "includeFiles": "dist/foodlytics/server/**"
    }
  }
}